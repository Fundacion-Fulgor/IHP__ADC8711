set SCRIPT_DIR [file dirname [file normalize [info script]]]
set env(PDK) ihp-sg13g2
if {![info exists env(PDK_ROOT)] || ![file exists $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc]} {
    set env(PDK_ROOT) $SCRIPT_DIR/IHP-Open-PDK
}
set PDK_ROOT $env(PDK_ROOT)
set PDK $env(PDK)
if {![file exists $PDK_ROOT/$PDK/libs.tech/xschem/xschemrc]} {
    puts "ERROR: IHP-Open-PDK no esta disponible."
    puts "Defina PDK_ROOT o inicialice los submodulos: git submodule update --init --recursive"
    exit 1
}
set IO_LIBRARY_PATH $SCRIPT_DIR/openpdk-libraries/ihp-sg13g2/sg13g2_io/xschem
if {![file isdirectory $IO_LIBRARY_PATH]} {
    puts "ERROR: openpdk-libraries no esta disponible."
    puts "Ejecute: git submodule update --init --recursive"
    exit 1
}
source $PDK_ROOT/$PDK/libs.tech/xschem/xschemrc
append XSCHEM_LIBRARY_PATH :$SCRIPT_DIR/ADC8711-main/schematic/xschem
append XSCHEM_LIBRARY_PATH :$SCRIPT_DIR/ADC8711-main/testbenches/ac/xschem
append XSCHEM_LIBRARY_PATH :$SCRIPT_DIR/ADC8711-main/testbenches/tran/xschem
append XSCHEM_LIBRARY_PATH :$SCRIPT_DIR/ADC8711-main/testbenches/noise/xschem
append XSCHEM_LIBRARY_PATH :$SCRIPT_DIR/ADC8711-main/testbenches/corners/xschem
append XSCHEM_LIBRARY_PATH :$PDK_ROOT/$PDK/libs.ref/sg13g2_pr/xschem
append XSCHEM_LIBRARY_PATH :$PDK_ROOT/$PDK/libs.ref/sg13g2_stdcell/sym/xschem
append XSCHEM_LIBRARY_PATH :$IO_LIBRARY_PATH
append XSCHEM_LIBRARY_PATH :$PDK_ROOT/$PDK/libs.tech/xschem/sg13g2_pr
set local_netlist_dir 0
if {![info exists netlist_dir] || $netlist_dir eq "$PDK_ROOT/$PDK/libs.tech/xschem/simulation"} {
    set netlist_dir $SCRIPT_DIR/ADC8711-main/netlist/schematic
}
